# Copy to .env and adjust. .env is gitignored; never commit credentials.

# ── PostGIS ───────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=ghana
PGUSER=ghana
PGPASSWORD=ghana

# ── Object storage (MinIO in development, S3 in production) ───────────────
MINIO_USER=ghana
MINIO_PASSWORD=ghanaghana
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=ghana-geostack

# ── API keys, all optional ────────────────────────────────────────────────
# OpenTopography, for SRTM downloads: https://portal.opentopography.org
OPENTOPO_API_KEY=

# NASA FIRMS, for active fire detections
FIRMS_MAP_KEY=

# Google Earth Engine project, only if using the GEE path rather than STAC
GEE_PROJECT=

# ── Behaviour ─────────────────────────────────────────────────────────────
GHANA_LOG_LEVEL=INFO
# GHANA_DATA_DIR=/mnt/bigdisk/ghana-data
