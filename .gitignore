# Data. Everything under data/ is fetched or derived, except the reference
# boundaries, which are small, versioned and part of the repository.
data/raw/*
data/interim/*
data/processed/*
data/exports/*
!data/**/.gitkeep
!data/reference/
!data/reference/**

# Build outputs
public/
site/

# Documentation pages generated by scripts/sync_docs.py from their canonical
# source elsewhere in the repository. Editing these has no effect; edit the
# source and run `make docs`.
docs/skill/
docs/project/
*.pmtiles
*.mbtiles
*.duckdb
*.duckdb.wal

# Credentials. Never committed: .env holds the database password, the Earth
# Engine project id and any model API key.
.env
.env.*
!.env.example
*.pem
service-account*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node, for the Vercel functions
node_modules/
.vercel/

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
